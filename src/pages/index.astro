---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import ChatBox from '../components/ChatBox.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Finale from '../components/Finale.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="David Cueva · Webflow & JavaScript expert"
  description="David Cueva, Webflow & JavaScript expert in Berlin. You bring your business. I make it live."
>
  <Header />
  <main class="wrap">
    <Hero />
    <Story />
    <section id="chat" class="chat">
      <ChatBox />
    </section>
    <Services />
    <Work />
    <Finale />
  </main>
  <Footer />
</Base>

<style>
  .chat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding-top: clamp(104px, 13vw, 160px);
  }
</style>
