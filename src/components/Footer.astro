---
import Logo from './Logo.astro';
import { socials } from '../data/site';

const links = [{ label: 'Impressum', href: '/impressum' }, { label: 'Privacy', href: '/privacy' }, ...socials];
---

<footer class="wrap site-footer">
  <Logo size={20} />
  <nav aria-label="Footer">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-top: 120px;
    padding-bottom: 48px;
    font-size: 16px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--petrol);
  }
  a:hover {
    color: var(--petrol-hover);
  }
</style>
