---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  /** The page's h1. */
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<Base title={title} description={description}>
  <header class="wrap legal-header">
    <a href="/" aria-label="David Cueva, home" class="home-link"><Logo /></a>
  </header>
  <main class="wrap legal">
    <h1>{heading}</h1>
    <slot />
  </main>
</Base>

<style>
  .legal-header {
    padding-block: 24px;
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .legal {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 80px;
    padding-bottom: 120px;
  }
  h1 {
    font-size: clamp(44px, 6.6vw, 96px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }
</style>
